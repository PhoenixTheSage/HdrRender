<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <TargetFrameworks Condition="'$(MSBuildRuntimeType)' == 'Core'">net48;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(MSBuildRuntimeType)' != 'Core'">net48</TargetFrameworks>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>ClientPlugin</RootNamespace>
    <AssemblyName>HdrOutput.Dx11</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <Bin64 Condition="'$(Bin64)'=='' AND Exists('T:\SteamLibrary\steamapps\common\SpaceEngineers\Bin64')">T:\SteamLibrary\steamapps\common\SpaceEngineers\Bin64</Bin64>
    <Bin64 Condition="'$(Bin64)'=='' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers\Bin64')">C:\Program Files (x86)\Steam\steamapps\common\SpaceEngineers\Bin64</Bin64>
    <Bin64Dir>$(Bin64)\</Bin64Dir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="ClientPlugin.csproj" AdditionalProperties="SkipDx11Satellite=true;RunPostBuildEvent=Never" />
    <Compile Include="Anomaly\Dx11Entry.cs" />
    <Compile Include="Anomaly\AnomalyHook.cs" />
    <Compile Include="Anomaly\RenderTraceBind.cs" />
    <Compile Include="Rendering\HdrResources.cs" />
    <Compile Include="Rendering\UiBoost.cs" />
    <Compile Include="Rendering\ExrWriter.cs" />
    <Compile Include="Patches\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Publicize Include="VRage.Render11" />
    <Publicize Include="VRage.Platform.Windows" />
    <Publicize Include="VRage.Math" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Sandbox.Common"><HintPath>$(Bin64Dir)Sandbox.Common.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Sandbox.Game"><HintPath>$(Bin64Dir)Sandbox.Game.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Sandbox.Graphics"><HintPath>$(Bin64Dir)Sandbox.Graphics.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage"><HintPath>$(Bin64Dir)VRage.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Game"><HintPath>$(Bin64Dir)VRage.Game.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Library"><HintPath>$(Bin64Dir)VRage.Library.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Math"><HintPath>$(Bin64Dir)VRage.Math.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Platform.Windows"><HintPath>$(Bin64Dir)VRage.Platform.Windows.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Render"><HintPath>$(Bin64Dir)VRage.Render.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="VRage.Render11"><HintPath>$(Bin64Dir)VRage.Render11.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SixLabors.Core"><HintPath>$(Bin64Dir)SixLabors.Core.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SixLabors.ImageSharp"><HintPath>$(Bin64Dir)SixLabors.ImageSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SharpDX"><HintPath>$(Bin64Dir)SharpDX.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SharpDX.Direct3D11"><HintPath>$(Bin64Dir)SharpDX.Direct3D11.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SharpDX.DXGI"><HintPath>$(Bin64Dir)SharpDX.DXGI.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="SharpDX.D3DCompiler"><HintPath>$(Bin64Dir)SharpDX.D3DCompiler.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
