<Project>
  <!-- Device and shared projects must have separate NuGet and intermediate state. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ClientPlugin.Dx11'">
    <BaseIntermediateOutputPath>obj/Dx11/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <!-- Folders overridable by Directory.Build.props.user -->
  <PropertyGroup>
    <!-- Folder containing SpaceEngineers.exe.
         Leave empty to use the platform-specific auto-detection in ClientPlugin.csproj. -->
    <Bin64></Bin64>

    <!-- Folder containing Legacy.exe (Pulsar). Empty = auto-detect from Bin64 or %AppData%\Pulsar. -->
    <Pulsar></Pulsar>

    <!-- Plugin version -->
    <Version>1.3.2</Version>
    <AssemblyVersion>1.3.2.0</AssemblyVersion>
    <FileVersion>1.3.2.0</FileVersion>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
  </PropertyGroup>
</Project>
